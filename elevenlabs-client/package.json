{
  "name": "@btkulka/elevenlabs-client",
  "version": "0.1.0",
  "description": "ElevenLabs REST client for the endpoints Ben's apps call: text-to-speech, sound generation and the voice list. The API key is passed in. Retries with Retry-After on 429 and backoff on 5xx/network errors, per-attempt timeouts, AbortSignal, typed errors (auth vs quota vs other), plus Node helpers to write audio atomically and memoize renders on disk. No runtime dependencies.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/btkulka/packages.git",
    "directory": "elevenlabs-client"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "benhaus": {
    "credential": {
      "label": "ElevenLabs",
      "docs": "https://elevenlabs.io/app/settings/api-keys",
      "fields": [
        {
          "name": "apiKey",
          "label": "API key",
          "secret": true,
          "env": "ELEVENLABS_API_KEY",
          "placeholder": "sk_..."
        }
      ],
      "test": {
        "method": "GET",
        "url": "https://api.elevenlabs.io/v2/voices?page_size=1",
        "headers": {
          "xi-api-key": "{apiKey}"
        },
        "expect": [
          200
        ],
        "hints": [
          {
            "status": 401,
            "match": "missing_permissions",
            "message": "The key works but can't read voices: give it Voices access in ElevenLabs."
          },
          {
            "status": 401,
            "message": "ElevenLabs didn't accept the key."
          }
        ]
      }
    }
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.test.*.map",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node ../scripts/cjs-marker.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/esm/**/*.test.js\"",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
