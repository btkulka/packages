{
  "name": "@btkulka/soundcloud-client",
  "version": "0.1.0",
  "description": "SoundCloud API over the client-credentials flow: a cached token, 401 refresh and 429 Retry-After handling, and only the calls Ben's apps make: track and user search, a user by id, /resolve, a reachability ping, and the public api-v2 track search with a scraped, cached client_id for when no credentials are set. No node:* imports, no runtime dependencies.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/btkulka/packages.git",
    "directory": "soundcloud-client"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.test.*.map",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node ../scripts/cjs-marker.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/esm/**/*.test.js\"",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
