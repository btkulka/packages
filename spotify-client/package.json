{
  "name": "@btkulka/spotify-client",
  "version": "0.1.0",
  "description": "Spotify Web API over the client-credentials flow: a cached token (memory, or a store the app hands in), 401 refresh and 429 Retry-After handling, and only the calls Ben's apps make: search, artist, albums in batches of 20, public playlist tracks, and Spotify URL/URI/ID parsing. Runs in Node and in the browser (global fetch, no node:* imports, no Buffer). No runtime dependencies.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/btkulka/packages.git",
    "directory": "spotify-client"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "benhaus": {
    "credential": {
      "label": "Spotify",
      "docs": "https://developer.spotify.com/dashboard",
      "fields": [
        {
          "name": "clientId",
          "label": "Client ID",
          "secret": false,
          "env": "SPOTIFY_CLIENT_ID"
        },
        {
          "name": "clientSecret",
          "label": "Client secret",
          "secret": true,
          "env": "SPOTIFY_CLIENT_SECRET"
        }
      ],
      "test": {
        "method": "POST",
        "url": "https://accounts.spotify.com/api/token",
        "basicAuth": [
          "clientId",
          "clientSecret"
        ],
        "form": {
          "grant_type": "client_credentials"
        },
        "expect": [
          200
        ],
        "hints": [
          {
            "match": "invalid_client",
            "message": "Spotify doesn't know this client ID and secret together: check both on the app's Settings page."
          }
        ]
      }
    }
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.test.*.map",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node ../scripts/cjs-marker.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/esm/**/*.test.js\"",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
