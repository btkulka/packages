{
  "name": "@btkulka/media-kit",
  "version": "0.1.0",
  "description": "Find and run ffmpeg, ffprobe and yt-dlp: binary resolution (env override, the app's bundled binary, PATH, known Windows install dirs, a GPU-capable preference, cached), a spawn wrapper with progress, abort and timeout, ffprobe JSON, audio conversion, loudness, hardware-encoder probing and yt-dlp download/JSON/version. Never imports ffmpeg-static: apps pass it in. No runtime dependencies.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/btkulka/packages.git",
    "directory": "media-kit"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.test.*.map",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node ../scripts/cjs-marker.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/esm/**/*.test.js\"",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@btkulka/proc-kit": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
