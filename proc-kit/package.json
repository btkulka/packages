{
  "name": "@btkulka/proc-kit",
  "version": "0.1.0",
  "description": "Process and dev tooling Ben's apps kept re-implementing: who holds a port and freeing it, killing a process tree, detached spawns with a log file, waiting for a port or an HTTP health URL, a clean env for launching Electron, PATH lookup, process lists, PID files. Windows first, POSIX kept. No runtime dependencies.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/btkulka/packages.git",
    "directory": "proc-kit"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.test.*.map",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node ../scripts/cjs-marker.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/esm/**/*.test.js\"",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
